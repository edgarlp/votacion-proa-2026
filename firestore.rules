rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /votos/{votoId} {
      allow read: if request.auth != null;
      allow create: if
        request.auth != null &&
        request.time < timestamp.value('2026-09-21T18:00:00Z') &&
        votoId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['docente', 'coreografia', 'decoracion', 'accesorio', 'creado']) &&
        request.resource.data.docente is string &&
        request.resource.data.docente.size() >= 5 &&
        request.resource.data.docente.size() <= 70 &&
        request.resource.data.coreografia in ['1.º','2.º A','2.º B','3.º A','3.º B','4.º','5.º','6.º'] &&
        request.resource.data.decoracion in ['1.º','2.º A','2.º B','3.º A','3.º B','4.º','5.º','6.º'] &&
        request.resource.data.accesorio in ['1.º','2.º A','2.º B','3.º A','3.º B','4.º','5.º','6.º'];
      allow update, delete: if false;
    }
  }
}
